1A:79:74:B1:B9&stream=1982518.mkv&play_token=UcCDKicjWN&type=series"}, {"id": "46742:1:4", "episode_num": "4", "season": "1", "title": "ES - ENA. La reina Victoria Eugenia (2025) (ES) - S01E04", "container_extension": "mkv", "info": {"movie_image": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/90fovFXIKRdDR9loh4r33zsAnG2.jpg", "plot": "", "season": "1", "episode": "4"}, "stream_url": "http://mag.greatott.me:80/play/movie.php?mac=00:1A:79:74:B1:B9&stream=1989244.mkv&play_token=RJirOgYYJJ&type=series"}, {"id": "46742:1:5", "episode_num": "5", "season": "1", "title": "ES - ENA. La reina Victoria Eugenia (2025) (ES) - S01E05", "container_extension": "mkv", "info": {"movie_image": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/90fovFXIKRdDR9loh4r33zsAnG2.jpg", "plot": "", "season": "1", "episode": "5"}, "stream_url": "http://mag.greatott.me:80/play/movie.php?mac=00:1A:79:74:B1:B9&stream=1989245.mkv&play_token=P89ATgbJTL&type=series"}, {"id": "46742:1:6", "episode_num": "6", "season": "1", "title": "ES - ENA. La reina Victoria Eugenia (2025) (ES) - S01E06", "container_extension": "mkv", "info": {"movie_image": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/90fovFXIKRdDR9loh4r33zsAnG2.jpg", "plot": "", "season": "1", "episode": "6"}, "stream_url": "http://mag.greatott.me:80/play/movie.php?mac=00:1A:79:74:B1:B9&stream=1993578.mkv&play_token=BzKap1Rq8a&type=series"}]}, "info": {"name": "ES - ENA. La reina Victoria Eugenia (2025) (ES)", "cover": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/90fovFXIKRdDR9loh4r33zsAnG2.jpg", "plot": "Ena es la historia de una reina y también de una mujer. De una joven inglesa que jamás había soñado ser reina de España. Alfonso XIII, con diecinueve años y Rey de España desde 1902, se fijó en ella, una elección que contrarió a su madre, María Cristina. En el viaje, dejó atrás a su familia, sus costumbres, su cultura y tuvo que renunciar a su religión para vivir en tierra extraña, en la que lo primero que sufrió fue un atentado el mismo día de su boda, durante el desfile nupcial en la calle Mayor, tras casarse en la Iglesia de los Jerónimos, y que causó decenas de víctimas. Nunca se sintió aceptada ni querida, pero luchó siempre para conseguir ambas cosas. Moderna en un ambiente tradicional, fue icono de la moda y de la liberación de las costumbres femeninas. Aunque en España se la conoce más como Victoria Eugenia, en la Familia Real británica y en su círculo de amistades siempre la llamaron, cariñosamente, Ena, un homenaje a su nacimiento en tierras escocesas, donde pasó su infancia.", "cast": "", "director": "", "genre": "", "rating": "7", "year": "2025-11-24", "category_id": "949"}}