0_bestv2/4jMwp7l9gtXvCHKmmtyGz2nuWva.jpg", "plot": "", "season": "3", "episode": "9"}, "stream_url": "http://mag.greatott.me:80/play/movie.php?mac=00:1A:79:74:B1:B9&stream=1561068.mkv&play_token=0uVQXUtPXP&type=series"}, {"id": "34420:3:10", "episode_num": "10", "season": "3", "title": "ES - Absentia - S03E10", "container_extension": "mkv", "info": {"movie_image": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/4jMwp7l9gtXvCHKmmtyGz2nuWva.jpg", "plot": "", "season": "3", "episode": "10"}, "stream_url": "http://mag.greatott.me:80/play/movie.php?mac=00:1A:79:74:B1:B9&stream=1561069.mkv&play_token=PZkmQ0sWTm&type=series"}]}, "info": {"name": "ES - Absentia", "cover": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/4jMwp7l9gtXvCHKmmtyGz2nuWva.jpg", "plot": "Mientras persigue a un asesino en serie, una agente del FBI desaparece y es dada por muerta, dejando solos a su marido, también agente, y a su hijo de 3 años. Pero 6 años después reaparece para sorpresa de todos. Sin recordar nada de lo sucedido desde su secuestro, tiene que adaptarse a una nueva realidad en la que su marido ha rehecho su vida con otra mujer y su hijo no la conoce. Además, una nueva serie de asesinatos hacen pensar a algunos de sus compañeros que ella podría ser la autora.", "cast": "", "director": "", "genre": "", "rating": "7", "year": "2017-09-25", "category_id": "949"}}