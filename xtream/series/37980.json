ries"}, {"id": "37980:4:7", "episode_num": "7", "season": "4", "title": "ES - Brockmire (2017) - S04E07", "container_extension": "mkv", "info": {"movie_image": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/5qt3pvbEqIhCI2pBCAPES0v8zP3.jpg", "plot": "", "season": "4", "episode": "7"}, "stream_url": "http://mag.greatott.me:80/play/movie.php?mac=00:1A:79:74:B1:B9&stream=1700738.mkv&play_token=1V1xXLpBX6&type=series"}, {"id": "37980:4:8", "episode_num": "8", "season": "4", "title": "ES - Brockmire (2017) - S04E08", "container_extension": "mkv", "info": {"movie_image": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/5qt3pvbEqIhCI2pBCAPES0v8zP3.jpg", "plot": "", "season": "4", "episode": "8"}, "stream_url": "http://mag.greatott.me:80/play/movie.php?mac=00:1A:79:74:B1:B9&stream=1700739.mkv&play_token=5wkXLvf5AD&type=series"}]}, "info": {"name": "ES - Brockmire (2017)", "cover": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/5qt3pvbEqIhCI2pBCAPES0v8zP3.jpg", "plot": "Jim Brockmire fue el locutor de deportes más grande de la televisión. Tenía éxito, dinero y una vida perfecta hasta que descubrió que su mujer le había sido infiel. A raíz de este suceso, sufre una vergonzosa crisis mientras está narrando un importante partido de béisbol y se retira del mundo del espectáculo. Una década más tarde, Brockmire decide retomar su carrera en una decandente ciudad de Nueva York donde comienza a trabajar para una radio local que retransmite una pequeña liga de béisbol que quiere conseguir la gloria. Jules es la propietaria y Charles el joven entrenador de este equipo que acaba de fichar a una vieja gloria de la televisión para intentar conseguir un poco de renombre.", "cast": "", "director": "", "genre": "", "rating": "7", "year": "2017-04-05", "category_id": "949"}}