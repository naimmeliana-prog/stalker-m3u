:B1:B9&stream=2015980.mp4&play_token=PulDMYihVp&type=series"}, {"id": "34312:4:10", "episode_num": "10", "season": "4", "title": "ES - Spartacus - S04E10", "container_extension": "mkv", "info": {"movie_image": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/c2GKN4VHCj1dnjFMANRpGkCVBae.jpg", "plot": "", "season": "4", "episode": "10"}, "stream_url": "http://mag.greatott.me:80/play/movie.php?mac=00:1A:79:74:B1:B9&stream=1558280.mkv&play_token=3akzuNzU26&type=series"}]}, "info": {"name": "ES - Spartacus", "cover": "https://image.tmdb.org/t/p/w600_and_h900_bestv2/c2GKN4VHCj1dnjFMANRpGkCVBae.jpg", "plot": "Traicionado por su país. Convertido en esclavo. Renacido como guerrero. Spartacus protagoniza la historia más gráfica y visceral del gladiador más famoso de Roma. Con un reparto estelar, asistimos a una mezcla única de acción, efectos gráficos y brutales batallas. Separado del amor de su vida, Spartacus tendrá que luchar por su supervivencia, participando en un espectáculo, donde el principal entretenimiento es la muerte. En un mundo de corrupción, violencia, sexo y fama acabará interviniendo en política y vivirá atormentado por el deseo de venganza.", "cast": "", "director": "", "genre": "", "rating": "8", "year": "2010-01-22", "category_id": "949"}}